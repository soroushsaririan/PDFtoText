# Python
__pycache__/
*.pyc
.venv/
.venv-vlm/
.pytest_cache/

# Generated data / outputs (reproducible via scripts, not source)
sample_usb/
outputs/
outputs_real*/

# Benchmark data (large, third-party licensed -- fetched on demand)
benchmark/data/

# Prompt-style harness output (regenerated by benchmark/run_prompt_styles.py)
benchmark/prompt_styles.csv
benchmark/prompt_styles.json
benchmark/prompt_styles.xlsx
benchmark/prompt_styles_crops/

# Any other run of the same harness (e.g. --out real_ground_truth_sample) --
# these contain real participant handwriting crops and hand-typed ground
# truth values and must never be committed.
benchmark/*.csv
benchmark/*.json
benchmark/*.xlsx
benchmark/*_crops/
benchmark/*_crops_*/
!benchmark/results_*.csv

# macOS
.DS_Store

# Editor
.vscode/
.idea/
benchmark/label_sheet.html
